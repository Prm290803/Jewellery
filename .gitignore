# Dependencies — never commit these
node_modules/
**/node_modules/

# Secrets — never commit. Use .env.example as the template.
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example

# Build output
dist/
dist-ssr/
build/
.vite/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.local
